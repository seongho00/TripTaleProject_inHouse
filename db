DROP DATABASE IF EXISTS `TripTale_project`;
CREATE DATABASE `TripTale_project`;
USE `TripTale_project`;

# 게시글 테이블 생성
CREATE TABLE `member` (
	id INT(10) UNSIGNED NOT NULL PRIMARY KEY AUTO_INCREMENT,
	provider VARCHAR(20) NOT NULL, -- 'local', 'kakao', 'naver' 등
	providerId VARCHAR(255),                       -- 소셜 회원은 고유 ID, 자체 회원은 NULL
	regDate DATETIME NOT NULL,
	updateDate DATETIME NOT NULL,
	loginPw VARCHAR(50),
	`name` VARCHAR(20) NOT NULL,
	email VARCHAR(100) NOT NULL,
	profileImage TEXT,
	delStatus TINYINT(1) NOT NULL DEFAULT 0,
	delDate DATETIME,
	authLevel SMALLINT(2) NOT NULL DEFAULT 7
	
);


